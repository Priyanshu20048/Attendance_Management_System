<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Attendify | Smart Attendance Management</title>
  <style>
    :root {
      --primary: #172554;
      --primary-strong: #0f172a;
      --primary-soft: #eef4ff;
      --surface: #ffffff;
      --surface-alt: #f5f7fb;
      --surface-soft: #f3f6ff;
      --text: #111827;
      --muted: #5b6477;
      --border: #e7ebf3;
      --success: #1f9d72;
      --success-soft: #e6f8f1;
      --warning: #c78a00;
      --shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
      --shadow-soft: 0 10px 25px rgba(15, 23, 42, 0.06);
      --radius: 18px;
      --radius-lg: 28px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Segoe UI", Inter, sans-serif;
      background: #f8fafc;
      color: var(--text);
      line-height: 1.6;
      overflow-x: hidden;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    img, svg {
      display: block;
      max-width: 100%;
    }

    button {
      font: inherit;
      cursor: pointer;
    }

    .container {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 40;
      backdrop-filter: blur(10px);
      background: rgba(248, 250, 252, 0.82);
      border-bottom: 1px solid rgba(231, 235, 243, 0.9);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 82px;
      gap: 20px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    .brand-mark {
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: linear-gradient(135deg, #dfeafc 0%, #cfe2ff 100%);
      color: var(--primary);
      border: 1px solid rgba(23, 37, 84, 0.08);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.8);
      font-size: 0.95rem;
    }

    .brand-text {
      font-size: 1.05rem;
      color: var(--primary-strong);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .nav-links a {
      transition: color 0.2s ease;
    }

    .nav-links a:hover {
      color: var(--primary);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border-radius: 999px;
      padding: 0.8rem 1.2rem;
      font-weight: 600;
      font-size: 0.95rem;
      border: 1px solid transparent;
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      white-space: nowrap;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
      box-shadow: 0 14px 24px rgba(23, 37, 84, 0.18);
    }

    .btn-primary:hover {
      box-shadow: 0 18px 28px rgba(23, 37, 84, 0.22);
    }

    .btn-ghost {
      background: rgba(255,255,255,0.6);
      color: var(--primary);
      border-color: var(--border);
    }

    .mobile-menu-toggle {
      display: none;
      width: 42px;
      height: 42px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--surface);
      align-items: center;
      justify-content: center;
      color: var(--primary);
    }

    .mobile-menu-toggle span,
    .mobile-menu-toggle::before,
    .mobile-menu-toggle::after {
      content: "";
      display: block;
      width: 18px;
      height: 2px;
      background: currentColor;
      border-radius: 2px;
      transition: transform 0.2s ease;
    }

    .mobile-menu-toggle::before,
    .mobile-menu-toggle::after {
      position: absolute;
    }

    .mobile-menu-toggle {
      position: relative;
    }

    .mobile-menu-toggle span {
      position: relative;
    }

    .mobile-menu-toggle.is-open span {
      opacity: 0;
    }

    .mobile-menu-toggle.is-open::before {
      transform: rotate(45deg);
      top: 19px;
    }

    .mobile-menu-toggle.is-open::after {
      transform: rotate(-45deg);
      top: 19px;
    }

    .mobile-menu {
      display: none;
      padding: 0 16px 18px;
      background: rgba(248, 250, 252, 0.98);
      border-bottom: 1px solid var(--border);
    }

    .mobile-menu.open {
      display: block;
    }

    .mobile-menu nav {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding-top: 12px;
    }

    .mobile-menu a {
      padding: 0.7rem 0.9rem;
      border-radius: 10px;
      color: var(--muted);
      font-weight: 500;
    }

    .mobile-menu a:hover {
      background: var(--surface-soft);
      color: var(--primary);
    }

    .hero {
      padding: 66px 0 42px;
    }

    .hero-inner {
      display: grid;
      grid-template-columns: 1.08fr 0.92fr;
      gap: 48px;
      align-items: center;
      min-height: 640px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: var(--primary-soft);
      border: 1px solid rgba(23, 37, 84, 0.08);
      color: var(--primary);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      border-radius: 999px;
      padding: 0.6rem 0.9rem;
      margin-bottom: 18px;
      font-weight: 700;
    }

    .eyebrow::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 0 5px rgba(31, 157, 114, 0.12);
    }

    h1 {
      font-size: clamp(2.7rem, 4vw, 5rem);
      line-height: 1.02;
      letter-spacing: -0.05em;
      max-width: 620px;
      margin-bottom: 18px;
      color: var(--primary-strong);
    }

    .hero-copy p {
      font-size: 1.08rem;
      color: var(--muted);
      max-width: 600px;
      margin-bottom: 28px;
    }

    .cta-row {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }

    .mini-note {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .hero-card {
      position: relative;
      background: linear-gradient(180deg, rgba(255,255,255,0.88), rgba(255,255,255,0.95));
      border: 1px solid rgba(231, 235, 243, 0.9);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
      padding: 22px;
    }

    .hero-card::before {
      content: "";
      position: absolute;
      inset: 12px auto auto 18px;
      width: 180px;
      height: 180px;
      background: radial-gradient(circle, rgba(30, 64, 175, 0.1), transparent 68%);
      border-radius: 50%;
      filter: blur(12px);
    }

    .card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 22px;
      position: relative;
      z-index: 1;
    }

    .card-title {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--primary-strong);
    }

    .live-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 0.38rem 0.7rem;
      border-radius: 999px;
      background: var(--success-soft);
      color: var(--success);
      font-size: 0.76rem;
      font-weight: 700;
      border: 1px solid rgba(31, 157, 114, 0.14);
    }

    .live-pill::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--success);
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.9fr;
      gap: 16px;
      position: relative;
      z-index: 1;
    }

    .overview-box {
      background: linear-gradient(180deg, var(--primary-soft), rgba(255,255,255,0.94));
      border: 1px solid rgba(191, 219, 254, 0.75);
      border-radius: 20px;
      padding: 16px 18px;
    }

    .overview-label {
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 10px;
    }

    .overview-value {
      font-size: clamp(2.3rem, 3vw, 3rem);
      font-weight: 800;
      line-height: 1;
      color: var(--primary);
      margin-bottom: 8px;
    }

    .metric-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-top: 16px;
    }

    .metric-tag {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 0.72rem;
      color: var(--success);
      background: var(--success-soft);
      border: 1px solid rgba(31, 157, 114, 0.12);
      border-radius: 999px;
      padding: 0.4rem 0.7rem;
      font-weight: 700;
    }

    .metric-tag::before {
      content: "↗";
      display: inline-block;
      transform: translateY(-1px);
    }

    .overview-note {
      font-size: 0.76rem;
      color: var(--muted);
      margin-top: 12px;
    }

    .list-box {
      background: var(--surface-alt);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 14px;
    }

    .list-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 8px 0;
      font-size: 0.8rem;
      color: var(--muted);
    }

    .list-item + .list-item {
      border-top: 1px dashed var(--border);
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 0.3rem 0.6rem;
      font-size: 0.7rem;
      font-weight: 700;
    }

    .status-pill.present {
      background: #ecfdf5;
      color: #13795c;
    }

    .status-pill.absent {
      background: #fff1f2;
      color: #b42318;
    }

    .chart-wrap {
      margin-top: 18px;
      position: relative;
      z-index: 1;
      background: var(--surface-alt);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 16px;
    }

    .chart-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      font-size: 0.75rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .bars {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 10px;
      height: 78px;
    }

    .bar {
      width: 100%;
      background: linear-gradient(180deg, #d9e9ff 0%, #7aa8ff 100%);
      border-radius: 8px 8px 0 0;
      min-height: 18%;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.45);
    }

    .section {
      padding: 24px 0 12px;
    }

    .section-wrap {
      padding: 42px 0;
    }

    .section-header {
      margin-bottom: 28px;
      max-width: 620px;
    }

    .section-header h2 {
      font-size: clamp(2rem, 3vw, 3rem);
      line-height: 1.1;
      letter-spacing: -0.04em;
      color: var(--primary-strong);
      margin-bottom: 12px;
    }

    .section-header p {
      color: var(--muted);
      font-size: 1.02rem;
    }

    .feature-cards {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }

    .feature-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 22px 20px;
      box-shadow: var(--shadow-soft);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .feature-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 32px rgba(15, 23, 42, 0.08);
    }

    .icon-box {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background: var(--primary-soft);
      color: var(--primary);
      margin-bottom: 16px;
      border: 1px solid rgba(23, 37, 84, 0.06);
    }

    .icon-box svg {
      width: 26px;
      height: 26px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .feature-card h3 {
      font-size: 1.18rem;
      margin-bottom: 8px;
      color: var(--primary-strong);
    }

    .feature-card p {
      color: var(--muted);
      font-size: 0.96rem;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .step {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 22px 20px;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-soft);
    }

    .step-label {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      font-size: 0.85rem;
      font-weight: 800;
      border-radius: 11px;
      color: var(--primary);
      background: var(--primary-soft);
      border: 1px solid rgba(23, 37, 84, 0.08);
      margin-bottom: 18px;
    }

    .step h3 {
      font-size: 1.2rem;
      color: var(--primary-strong);
      margin-bottom: 10px;
    }

    .step p {
      color: var(--muted);
      font-size: 0.96rem;
      margin-bottom: 16px;
    }

    .step-flow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--primary);
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-weight: 700;
    }

    .step-flow::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--primary);
      display: inline-block;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
    }

    .mini-feature {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px 16px;
      box-shadow: var(--shadow-soft);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .mini-feature:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 26px rgba(15, 23, 42, 0.08);
    }

    .mini-feature .mini-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: var(--primary-soft);
      border: 1px solid rgba(23, 37, 84, 0.06);
      display: grid;
      place-items: center;
      color: var(--primary);
      margin-bottom: 12px;
    }

    .mini-feature .mini-icon svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .mini-feature h3 {
      font-size: 1rem;
      margin-bottom: 6px;
      color: var(--primary-strong);
    }

    .mini-feature p {
      color: var(--muted);
      font-size: 0.88rem;
    }

    .cta-panel {
      background: linear-gradient(135deg, #f7f9ff 0%, #eef4ff 100%);
      border: 1px solid rgba(23, 37, 84, 0.08);
      border-radius: 24px;
      padding: 28px 26px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      box-shadow: var(--shadow-soft);
    }

    .cta-panel h3 {
      font-size: clamp(1.8rem, 2vw, 2.5rem);
      letter-spacing: -0.04em;
      line-height: 1.1;
      color: var(--primary-strong);
      margin-bottom: 8px;
    }

    .cta-panel p {
      color: var(--muted);
      font-size: 1rem;
    }

    .site-footer {
      padding: 32px 0 42px;
      border-top: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.5);
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .footer-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--primary-strong);
    }

    .footer-copy {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .footer-links {
      display: flex;
      align-items: center;
      gap: 18px;
      color: var(--muted);
      font-size: 0.94rem;
    }

    .footer-links a:hover {
      color: var(--primary);
    }

    @media (max-width: 980px) {
      .nav-links {
        display: none;
      }

      .mobile-menu-toggle {
        display: inline-flex;
      }

      .hero-inner,
      .feature-cards,
      .steps,
      .feature-grid {
        grid-template-columns: 1fr;
      }

      .hero-inner {
        min-height: unset;
      }

      .dashboard-grid {
        grid-template-columns: 1fr;
      }

      .feature-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .cta-panel {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media (max-width: 620px) {
      .nav-actions .btn {
        display: none;
      }

      .hero {
        padding-top: 44px;
      }

      .feature-grid {
        grid-template-columns: 1fr;
      }

      h1 {
        letter-spacing: -0.04em;
      }

      .cta-row {
        flex-direction: column;
        align-items: flex-start;
      }

      .btn {
        width: 100%;
      }

      .hero-card {
        padding: 18px 16px;
      }

      .footer-inner {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container nav-inner">
      <a href="/" class="brand" aria-label="Attendify home">
        <span class="brand-mark">A</span>
        <span class="brand-text">Attendify</span>
      </a>

      <nav class="nav-links" aria-label="Main navigation">
        <a href="#features">Features</a>
        <a href="#how-it-works">How It Works</a>
        <a href="#about">About</a>
      </nav>

      <div class="nav-actions">
        <a href="/login" class="btn btn-primary">Login</a>
        <button type="button" class="mobile-menu-toggle" aria-label="Open navigation" aria-expanded="false">
          <span></span>
        </button>
      </div>
    </div>
    <div class="mobile-menu" id="mobileMenu">
      <nav aria-label="Mobile navigation">
        <a href="#features">Features</a>
        <a href="#how-it-works">How It Works</a>
        <a href="#about">About</a>
        <a href="/login">Login</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <div class="eyebrow">Smart Attendance</div>
          <h1>Attendance management, made simple.</h1>
          <p>
            Manage students, teachers, attendance and reports from one centralized platform built for modern educational institutions.
          </p>

          <div class="cta-row">
            <a href="/login" class="btn btn-primary">Login to Dashboard</a>
            <a href="#features" class="btn btn-ghost">Explore Features</a>
          </div>

          <div class="mini-note">Built for schools and colleges that want a cleaner attendance workflow.</div>
        </div>

        <div class="hero-card" aria-label="Attendance dashboard mockup">
          <div class="card-top">
            <div class="card-title">Demo Snapshot</div>
            <span class="live-pill">Sample</span>
          </div>

          <div class="dashboard-grid">
            <div class="overview-box">
              <div class="overview-label">Sample</div>
              <div class="overview-value">87.6%</div>
              <div class="metric-row">
                <span class="metric-tag">+1.8%</span>
              </div>
              <div class="overview-note">Example weekly attendance trend</div>
            </div>

            <div class="list-box">
              <div class="list-item">
                <span>Present</span>
                <strong>421</strong>
              </div>
              <div class="list-item">
                <span>Absent</span>
                <strong>65</strong>
              </div>
              <div class="list-item">
                <span>Late</span>
                <strong>18</strong>
              </div>
            </div>
          </div>

          <div class="chart-wrap" aria-label="Attendance trend chart">
            <div class="chart-head">
              <span>Sample attendance trend</span>
              <span>7 days</span>
            </div>
            <div class="bars" aria-hidden="true">
              <span class="bar" style="height: 54%;"></span>
              <span class="bar" style="height: 68%;"></span>
              <span class="bar" style="height: 58%;"></span>
              <span class="bar" style="height: 75%;"></span>
              <span class="bar" style="height: 80%;"></span>
              <span class="bar" style="height: 83%;"></span>
              <span class="bar" style="height: 88%;"></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="section section-wrap">
      <div class="container">
        <div class="section-header">
          <h2>Everything you need to manage attendance.</h2>
        </div>

        <div class="feature-cards">
          <article class="feature-card">
            <div class="icon-box" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M7 4h10a2 2 0 0 1 2 2v12l-4-2-4 2-4-2-4 2V6a2 2 0 0 1 2-2zm3 5h4m-4 4h4"/></svg>
