<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Signup - AttendanceApp</title>
  <style>
    :root {
      --primary: #2563eb;
      --primary-light: #e0f2ff;
      --primary-dark: #1d4ed8;
      --text-main: #0f172a;
      --text-muted: #6b7280;
      --bg-soft: #f8fafc;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "Poppins", sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at top left, #e0f2ff 0, #ffffff 45%);
      color: var(--text-main);
      overflow-x: hidden;
    }

    /* Shared Background Elements */
    .bg-grid {
      position: fixed; inset: 0;
      background-image: linear-gradient(rgba(148, 163, 184, 0.10) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(148, 163, 184, 0.08) 1px, transparent 1px);
      background-size: 46px 46px; z-index: -3; opacity: 0.3;
    }
    .bg-glow {
      position: fixed; inset: 0;
      background: radial-gradient(circle at bottom right, rgba(219, 234, 254, 0.8), transparent 55%);
      z-index: -2;
    }

    .auth-wrapper {
      width: 100%; max-width: 1000px;
      padding: 20px;
      animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .auth-card {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(16px);
      border-radius: 28px;
      border: 1px solid rgba(255, 255, 255, 0.6);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
      overflow: hidden;
    }

    /* Left Side */
    .auth-side {
      background: linear-gradient(135deg, #2563eb, #38bdf8);
      color: white; padding: 40px;
      display: flex; flex-direction: column; justify-content: space-between;
    }

    /* Consistent Logo Orbit */
    .logo-icon-wrap { position: relative; width: 42px; height: 42px; margin-bottom: 15px;}
    .logo-orbit {
      position: absolute; inset: -4px; border-radius: 999px;
      background: conic-gradient(from 210deg, rgba(255,255,255,0.4), #fff, rgba(255,255,255,0.4));
      filter: blur(5px); animation: spin 6s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .logo-icon {
      position: relative; width: 100%; height: 100%; border-radius: 12px;
      background: white; color: var(--primary);
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 20px;
    }

    .auth-side h1 { font-size: 1.8rem; margin: 20px 0 10px; }
    .points-list { list-style: none; margin-top: 20px; }
    .points-list li { 
        font-size: 0.9rem; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; 
        background: rgba(255,255,255,0.1); padding: 8px 12px; border-radius: 10px;
    }

    /* Form Right Side */
    .auth-form-wrap { padding: 40px; background: white; }
    
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      margin-bottom: 20px;
    }

    .form-group.full { grid-column: span 2; }
    
    label { display: block; font-size: 0.85rem; font-weight: 500; margin-bottom: 6px; color: #4b5563; }
    
    .input-field, .select-field {
      width: 100%; padding: 11px 15px; border-radius: 10px;
      border: 1px solid #e5e7eb; background: #f9fafb;
      font-size: 0.95rem; transition: all 0.2s;
    }
    .input-field:focus, .select-field:focus {
      outline: none; border-color: var(--primary); background: white;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
    }

    /* Dynamic Teacher Section Styling */
    #teacherFields {
      background: #f0f7ff; padding: 15px; border-radius: 15px;
      border: 1px dashed #bfdbfe; animation: slideDown 0.3s ease-out;
    }
    @keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

    .btn-primary {
      width: 100%; padding: 13px; border-radius: 12px; border: none;
      background: linear-gradient(135deg, #60a5fa, #2563eb);
      color: white; font-weight: 600; font-size: 1rem;
      cursor: pointer; position: relative; overflow: hidden;
      box-shadow: 0 10px 20px rgba(37, 99, 235, 0.3);
      transition: transform 0.2s;
    }
    .btn-primary:hover { transform: translateY(-2px); }

    .alert { padding: 12px; border-radius: 10px; font-size: 0.85rem; margin-bottom: 15px; border: 1px solid; }
    .alert.error { background: #fee2e2; color: #b91c1c; border-color: #fecaca; }

    .footer-link { text-align: center; margin-top: 20px; font-size: 0.9rem; color: #6b7280; }
    .footer-link a { color: var(--primary); font-weight: 600; text-decoration: none; }

    @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

    @media (max-width: 850px) {
      .auth-card { grid-template-columns: 1fr; }
      .auth-side { display: none; }
      .form-grid { grid-template-columns: 1fr; }
      .form-group.full { grid-column: span 1; }
    }
  </style>
</head>
<body>
  <div class="bg-grid"></div>
  <div class="bg-glow"></div>

  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-side">
        <div>
          <div class="logo-icon-wrap">
            <div class="logo-orbit"></div>
            <div class="logo-icon">A</div>
          </div>
          <h1>Join the Community ✨</h1>
          <p>Digitize your classroom records in minutes. Start for free today.</p>
          
          <ul class="points-list">
            <li>✅ Role-specific dashboards</li>
            <li>✅ Auto-calculated percentages</li>
            <li>✅ One-click Excel exports</li>
          </ul>
        </div>
        <p style="font-size: 0.75rem; opacity: 0.7;">Join 500+ educators streamlining their daily workflow.</p>
      </div>

      <div class="auth-form-wrap">
        <h2 style="margin-bottom: 5px;">Create Account</h2>
        <p style="color: #6b7280; font-size: 0.9rem; margin-bottom: 25px;">Start your 14-day premium trial today.</p>

        <% if (error) { %>
          <div class="alert error"><%= error %></div>
        <% } %>

        <form action="/signup" method="POST">
          <div class="form-grid">
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" name="name" class="input-field" placeholder="John Doe" required>
            </div>
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" name="email" class="input-field" placeholder="john@college.edu" required>
            </div>
            <div class="form-group">
              <label>Password</label>
              <input type="password" name="password" class="input-field" placeholder="••••••••" required minlength="8">
            </div>
            <div class="form-group">
              <label>Role</label>
              <select name="role" id="role" class="select-field" required>
                <option value="" disabled selected>Choose role</option>
                <option value="admin">Admin</option>
                <option value="teacher">Teacher</option>
              </select>
            </div>

            <div class="form-group full" id="teacherFields" style="display:none;">
              <div style="margin-bottom: 12px;">
                <label>Subject Specialization</label>
                <input type="text" id="subject" name="subject" class="input-field" placeholder="e.g. Data Structures">
              </div>
              <div>
                <label>Classes Assigned (Comma separated)</label>
                <input type="text" id="classesInput" name="classesInput" class="input-field" placeholder="CS-A, CS-B, IT-A">
                <small style="color: #64748b; font-size: 0.75rem;">Example: SE-A, TE-B</small>
              </div>
            </div>
          </div>

          <button type="submit" class="btn-primary">Create Free Account</button>
        </form>

        <div class="footer-link">
          Already using AttendanceApp? <a href="/login">Login here</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const roleSelect = document.getElementById("role");
    const teacherFields = document.getElementById("teacherFields");
    const subjectInput = document.getElementById("subject");
    const classesInput = document.getElementById("classesInput");

    roleSelect.addEventListener("change", function () {
      if (this.value === "teacher") {
        teacherFields.style.display = "block";
        subjectInput.required = true;
        classesInput.required = true;
      } else {
        teacherFields.style.display = "none";
        subjectInput.required = false;
        classesInput.required = false;
      }
    });
  </script>
</body>
</html>