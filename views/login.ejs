<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login | Attendify</title>
  <style>
    :root {
      --primary: #172554;
      --primary-strong: #0f172a;
      --primary-soft: #eef4ff;
      --surface: #ffffff;
      --surface-alt: #f5f7fb;
      --text-main: #111827;
      --text-muted: #5b6477;
      --border-soft: #e7ebf3;
      --success: #1f9d72;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "Segoe UI", Inter, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f8fafc;
      color: var(--text-main);
      overflow: hidden;
    }

    /* Background Styles (Sync with Welcome Page) */
    .bg-grid {
      position: fixed; inset: 0;
      background-image: linear-gradient(rgba(23, 37, 84, 0.06) 1px, transparent 1px),
            linear-gradient(90deg, rgba(23, 37, 84, 0.06) 1px, transparent 1px);
      background-size: 46px 46px; z-index: -3; opacity: 0.45;
    }
    .bg-glow {
      position: fixed; inset: 0;
      background: radial-gradient(circle at bottom right, rgba(219, 234, 254, 0.72), transparent 55%),
          radial-gradient(circle at top left, rgba(238, 244, 255, 0.9), transparent 48%);
      z-index: -2;
    }

    /* Auth Wrapper */
    .auth-wrapper {
      width: 100%; max-width: 980px;
      padding: 20px;
      animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .auth-card {
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(16px);
      border-radius: 24px;
      border: 1px solid rgba(231, 235, 243, 0.9);
      box-shadow: 0 24px 55px rgba(15, 23, 42, 0.1);
      overflow: hidden;
    }

    /* Left Side: Gradient Info */
    .auth-side {
      background: linear-gradient(145deg, #172554 0%, #1e3a8a 58%, #2563eb 100%);
      color: white;
      padding: 46px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
    }

    /* Logo Styling (Consistent) */
    .logo-icon-wrap { width: 42px; height: 42px; margin-bottom: 22px;}
    .logo-orbit {
      display: none;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .logo-icon {
      width: 100%; height: 100%; border-radius: 12px;
      background: white; color: var(--primary);
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 20px; box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .auth-side h1 { font-size: 2.35rem; line-height: 1.08; letter-spacing: -0.04em; margin: 20px 0 14px; }
    .auth-side p { opacity: 0.9; font-size: 0.95rem; line-height: 1.6; }

    /* Right Side: Form */
    .auth-form-wrap { padding: 52px 48px; background: rgba(255, 255, 255, 0.96); }

    .badge-status {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 5px 12px; border-radius: 999px;
      background: var(--primary-soft); color: var(--primary);
      font-size: 0.75rem; font-weight: 500; margin-bottom: 20px;
    }
    .dot { width: 8px; height: 8px; background: var(--success); border-radius: 50%; box-shadow: 0 0 8px rgba(31, 157, 114, 0.7); }

    .input-group { margin-bottom: 20px; }
    .input-group label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; color: var(--primary-strong); }
    
    .input-field {
      width: 100%; padding: 12px 18px; border-radius: 12px;
      border: 1px solid var(--border-soft); background: var(--surface-alt);
      font-size: 0.95rem; transition: all 0.2s;
    }
    .input-field:focus {
      outline: none; border-color: var(--primary);
      background: var(--surface); box-shadow: 0 0 0 4px rgba(23, 37, 84, 0.1);
    }

    /* Primary Button with Shimmer (From Welcome Page) */
    .btn-primary {
      width: 100%; padding: 14px; border-radius: 999px; border: none;
      background: var(--primary);
      color: white; font-weight: 600; font-size: 1rem;
      cursor: pointer; position: relative; overflow: hidden;
      box-shadow: 0 12px 24px rgba(23, 37, 84, 0.2);
      transition: transform 0.2s;
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 16px 28px rgba(23, 37, 84, 0.25); }
    .btn-primary::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(120deg, transparent, rgba(255,255,255,0.4), transparent);
      transform: translateX(-120%); animation: shimmer 3s infinite;
    }
    @keyframes shimmer { 100% { transform: translateX(120%); } }

    .alert { padding: 12px; border-radius: 10px; font-size: 0.85rem; margin-bottom: 20px; border: 1px solid; }
    .alert.error { background: #fee2e2; color: #b91c1c; border-color: #fecaca; }

    .footer-link { text-align: center; margin-top: 25px; font-size: 0.9rem; color: var(--text-muted); }
    .footer-link a { color: var(--primary); font-weight: 600; text-decoration: none; }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--text-muted);
      font-size: 0.86rem;
      margin-bottom: 28px;
    }

    .back-link:hover { color: var(--primary); }

    @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

    @media (max-width: 768px) {
      .auth-card { grid-template-columns: 1fr; }
      .auth-side { display: none; }
      .auth-form-wrap { padding: 40px 30px; }
    }
  </style>
</head>
<body>
  <div class="bg-grid"></div>
  <div class="bg-glow"></div>

  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-side">
        <div>
          <div class="logo-icon-wrap">
            <div class="logo-orbit"></div>
            <div class="logo-icon">A</div>
          </div>
          <h1>Track class attendance smarter.</h1>
          <p>Sign in to manage your students, view subject-wise reports, and export data seamlessly.</p>
        </div>
        <div style="font-size: 0.8rem; opacity: 0.8;">Attendify · Smart Attendance Management</div>
      </div>

      <div class="auth-form-wrap">
        <a href="/" class="back-link">← Back to Attendify</a>
        <div class="badge-status">
          <span class="dot"></span> Authorized Access Only
        </div>
        <h2 style="margin-bottom: 5px;">Welcome Back</h2>
        <p style="color: #6b7280; font-size: 0.9rem; margin-bottom: 25px;">Please enter your details to login.</p>

        <% if (error) { %>
          <div class="alert error"><%= error %></div>
        <% } %>

        <form action="/login" method="POST">
          <div class="input-group">
            <label>Email Address</label>
            <input type="email" name="email" class="input-field" placeholder="name@college.edu" required>
          </div>
          <div class="input-group">
            <label>Password</label>
            <input type="password" name="password" class="input-field" placeholder="••••••••" required>
          </div>
          <button type="submit" class="btn-primary">Sign In</button>
        </form>

        <div class="footer-link">
          Contact admin to create a teacher account.
        </div>
      </div>
    </div>
  </div>
</body>
</html>