<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Profile | Attendify</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #2563eb;
      --bg: #f3f4f6;
      --card-bg: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border: #e2e8f0;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { 
      font-family: 'Plus Jakarta Sans', sans-serif; 
      background-color: var(--bg); 
      color: var(--text-main); 
      padding: 40px 20px;
    }

    .layout { 
      max-width: 1000px; 
      margin: 0 auto; 
      display: grid; 
      grid-template-columns: 300px 1fr; 
      gap: 30px;
    }

    /* Sidebar Profile Card */
    .sidebar { 
      background: var(--card-bg); 
      border-radius: 24px; 
      padding: 40px 24px; 
      border: 1px solid var(--border);
      text-align: center;
      height: fit-content;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
    }

    .avatar-container {
      position: relative;
      width: 120px;
      height: 120px;
      margin: 0 auto 20px;
    }

    .avatar, .avatar-fallback {
      width: 120px; height: 120px; 
      border-radius: 40px; /* Modern Squircle shape */
      object-fit: cover;
      border: 4px solid #f8fafc;
      box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
    }

    .avatar-fallback {
      display: flex; align-items: center; justify-content: center;
      font-size: 42px; font-weight: 700;
      background: var(--primary); color: white;
    }

    .profile-info h2 { font-size: 1.25rem; font-weight: 800; color: #0f172a; margin-bottom: 4px; }
    .profile-info p { font-size: 0.85rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 30px;}

    .nav-menu { text-align: left; border-top: 1px solid var(--border); padding: 20px; padding-top: 20px;}
    .nav-link {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 16px; margin-bottom: 8px;
      color: #475569; text-decoration: none; font-weight: 600; font-size: 0.9rem;
      border-radius: 12px; transition: 0.2s;
    }
    .nav-link:hover { background: #f1f5f9; color: var(--primary); }

    /* Main Content Card */
    .content-card {
      background: var(--card-bg); 
      border-radius: 24px; 
      padding: 40px; 
      border: 1px solid var(--border);
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
    }

    .content-card h1 { font-size: 1.75rem; font-weight: 800; margin-bottom: 8px; color: #0f172a; }
    .content-card p { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 30px; }

    /* Forms */
    .input-group { margin-bottom: 20px; }
    label { display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 8px; text-transform: uppercase; }
    
    .input-field {
      width: 100%; padding: 14px 16px; border-radius: 12px; border: 1.5px solid var(--border);
      background: #fcfcfc; font-family: inherit; font-size: 0.95rem; outline: none; transition: 0.2s;
    }
    .input-field:focus { border-color: var(--primary); background: white; box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.05); }

    .btn-save {
      background: var(--primary); color: white; border: none;
      padding: 16px 32px; border-radius: 12px; font-weight: 700;
      font-size: 1rem; cursor: pointer; transition: 0.3s; width: 100%;
    }
    .btn-save:hover { background: #1d4ed8; transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3); }

    .alert { padding: 14px; border-radius: 12px; margin-bottom: 20px; font-weight: 600; font-size: 0.9rem; }
    .alert.error { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
    .alert.success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }

    .remove-photo-box {
      display: flex; align-items: center; gap: 10px;
      padding: 12px; background: #f8fafc; border-radius: 10px; margin-top: 10px;
      font-size: 0.85rem; font-weight: 600; color: #64748b;
    }

    @media(max-width: 880px) {
      .layout { grid-template-columns: 1fr; }
      body { padding: 20px; }
    }
  </style>
</head>

<body>
<div class="layout">
  <div class="sidebar">
    <% 
      let hasPhoto = !!(user && user.profilePhoto);
      let avatarSrc = '/images/default-avatar.png';
      if (hasPhoto) {
        const p = String(user.profilePhoto).trim();
        avatarSrc = p.startsWith('http') ? p : (p.startsWith('/') ? p : '/' + p);
      }
      const initial = user?.name?.charAt(0).toUpperCase() || 'A';
    %>

    <div class="avatar-container">
      <% if (hasPhoto) { %>
        <img id="avatarImg" src="<%= avatarSrc %>" class="avatar">
        <div id="avatarInitial" class="avatar-fallback" style="display:none;"><%= initial %></div>
      <% } else { %>
        <div id="avatarInitial" class="avatar-fallback"><%= initial %></div>
        <img id="avatarImg" src="<%= avatarSrc %>" class="avatar" style="display:none;">
      <% } %>
    </div>

    <div class="profile-info">
      <h2>
   <a href="/admin/profile" style="text-decoration:none; color:inherit;">
      <%= user.name %>
   </a>
</h2>
      <p>Administrator</p>
    </div>

    <div class="nav-menu">
      <a href="/admin/dashboard" class="nav-link">📊 Dashboard</a>
      <a href="/admin/students" class="nav-link">👨‍🎓 Student Management</a>
      <a href="/admin/teachers" class="nav-link">👩‍🏫 Faculty Directory</a>
      <a href="/admin/reports" class="nav-link">📑 Attendance Reports</a>
    </div>
  </div>

  <div class="content-card">
    <h1>Account Settings</h1>
    <p>Update your personal information and security credentials.</p>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert success"><%= success %></div><% } %>

    <form method="POST" action="/admin/profile" enctype="multipart/form-data">
      <div class="input-group">
        <label>Full Name</label>
        <input class="input-field" name="name" value="<%= user.name %>" required placeholder="John Doe">
      </div>

      <div class="input-group">
        <label>Email Address</label>
        <input class="input-field" type="email" name="email" value="<%= user.email %>" required placeholder="admin@school.com">
      </div>

      <div class="input-group">
        <label>Change Password</label>
        <input class="input-field" type="password" name="password" placeholder="•••••••• (Leave blank to keep current)">
      </div>

      <div class="input-group">
        <label>Profile Picture</label>
        <input id="photoInput" class="input-field" type="file" name="profilePhoto" accept="image/*">
        
        <% if (hasPhoto) { %>
          <div class="remove-photo-box">
            <input id="removePhoto" type="checkbox" name="removePhoto" value="1">
            <label for="removePhoto" style="margin:0; text-transform:none; font-weight:600;">Remove current photo</label>
          </div>
        <% } %>
      </div>

      <button class="btn-save">Update Profile</button>
    </form>
  </div>
</div>

<script>
  // Script handles real-time avatar preview
  const checkbox = document.getElementById('removePhoto');
  const img = document.getElementById('avatarImg');
  const initial = document.getElementById('avatarInitial');
  const input = document.getElementById('photoInput');

  if (checkbox) {
    checkbox.onchange = () => {
      if (checkbox.checked) {
        img.style.display = 'none';
        initial.style.display = 'flex';
        input.disabled = true;
      } else {
        img.style.display = 'block';
        initial.style.display = 'none';
        input.disabled = false;
      }
    };
  }

  if (input) {
    input.onchange = () => {
      if (input.files.length) {
        if (checkbox) checkbox.checked = false;
        const reader = new FileReader();
        reader.onload = e => {
          img.src = e.target.result;
          img.style.display = 'block';
          initial.style.display = 'none';
        };
        reader.readAsDataURL(input.files[0]);
      }
    };
  }
</script>
</body>
</html>